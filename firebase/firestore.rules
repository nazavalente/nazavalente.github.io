rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function portfolioCollection(name) {
      return name in [
        "projects",
        "githubRepositories",
        "achievements",
        "skills",
        "experiences",
        "certificates"
      ];
    }

    match /{collectionName}/{documentId} {
      allow read: if portfolioCollection(collectionName);
      allow create, update, delete: if portfolioCollection(collectionName) && isAdmin();
    }

    match /contactMessages/{messageId} {
      // Public create must match exactly what createContactMessage() in
      // src/lib/firestore.js writes: no extra fields, unread, server timestamp.
      allow create: if request.resource.data.keys().hasOnly(["name", "email", "subject", "message", "isRead", "createdAt"])
        && request.resource.data.name is string && request.resource.data.name.size() <= 100
        && request.resource.data.email is string && request.resource.data.email.size() <= 200
        && request.resource.data.subject is string && request.resource.data.subject.size() <= 200
        && request.resource.data.message is string && request.resource.data.message.size() <= 5000
        && request.resource.data.isRead == false
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
